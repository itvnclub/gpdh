<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. Bảng điều khiển -->
        <rule name="Admin Dashboard" stopProcessing="true">
          <match url="^bang-dieu-khien/?$" />
          <action type="Rewrite" url="default.asp" />
        </rule>

        <!-- 2. Phả hệ dòng họ -->
        <rule name="Admin Quan Ly Pha Do" stopProcessing="true">
          <match url="^pha-do/?$" />
          <action type="Rewrite" url="default.asp?gpdh=12" />
        </rule>
	<rule name="Admin Them nhan vat" stopProcessing="true">
	  <match url="^them-nhan-vat/?$" />
	  <action type="Rewrite" url="default.asp?gpdh=13" />
	</rule>
	<rule name="Admin Sua nhan vat" stopProcessing="true">
	  <match url="^sua-nhan-vat/?$" />
	  <action type="Rewrite" url="default.asp?gpdh=14" />
	</rule>
	<rule name="Admin Them nhan vat ngoai" stopProcessing="true">
	  <match url="^them-nhan-vat-ngoai/?$" />
	  <action type="Rewrite" url="default.asp?gpdh=15" />
	</rule>
	<rule name="Admin Nhan vat ngoai" stopProcessing="true">
	  <match url="^nhan-vat-ngoai/?$" />
	  <action type="Rewrite" url="default.asp?gpdh=16" />
	</rule>
        <rule name="Admin Quan Ly Doi" stopProcessing="true">
          <match url="^quan-ly-doi/?$" />
          <action type="Rewrite" url="default.asp?gpdh=9" />
        </rule>
<rule name="Admin Sua Doi Theo ID" stopProcessing="true">
  <match url="^quan-ly-doi/sua/([0-9]+)/?$" />
  <action type="Rewrite" url="default.asp?gpdh=9&amp;id={R:1}" />
</rule>
	<!-- 3. Nội dung tư liệu - Nhóm Tin Tức -->
        <rule name="Admin Tin Tuc" stopProcessing="true">
          <match url="^tin-tuc/?$" />
          <action type="Rewrite" url="default.asp?gpdh=2" />
        </rule>
        <rule name="Admin Them Tin Tuc" stopProcessing="true">
          <match url="^them-tin-moi/?$" />
          <action type="Rewrite" url="default.asp?gpdh=1" />
        </rule>
        <rule name="Admin Sua Tin Tuc" stopProcessing="true">
          <match url="^sua-tin/?$" />
          <action type="Rewrite" url="default.asp?gpdh=3" />
        </rule>
        <rule name="Admin Gioi thieu" stopProcessing="true">
          <match url="^gioi-thieu/?$" />
          <action type="Rewrite" url="default.asp?gpdh=29" />
        </rule>
        <rule name="Admin Nhom Tin" stopProcessing="true">
	  <match url="^nhom-tin/?$" />
	  <action type="Rewrite" url="default.asp?gpdh=18" />
	</rule>
        <rule name="Admin Thong Tin Dong Ho" stopProcessing="true">
          <match url="^thong-tin-dong-ho/?$" />
          <action type="Rewrite" url="default.asp?gpdh=6" />
        </rule>
        <rule name="Admin Them Thong Tin Dong Ho" stopProcessing="true">
          <match url="^them-thong-tin-dong-ho/?$" />
          <action type="Rewrite" url="default.asp?gpdh=5" />
        </rule>
        <rule name="Admin Sua Thong Tin Dong Ho" stopProcessing="true">
          <match url="^sua-thong-tin-dong-ho/?$" />
          <action type="Rewrite" url="default.asp?gpdh=7" />
        </rule>
        <rule name="Admin Thu Vien Anh" stopProcessing="true">
          <match url="^thu-vien-anh/?$" />
          <action type="Rewrite" url="default.asp?gpdh=23" />
        </rule>
        <rule name="Admin Them Thu Vien Anh" stopProcessing="true">
          <match url="^them-thu-vien-anh/?$" />
          <action type="Rewrite" url="default.asp?gpdh=24" />
        </rule>
        <rule name="Admin Sua Thu Vien Anh" stopProcessing="true">
          <match url="^sua-thu-vien-anh/?$" />
          <action type="Rewrite" url="default.asp?gpdh=25" />
        </rule>
        <rule name="Admin Thu Vien Video" stopProcessing="true">
          <match url="^thu-vien-video/?$" />
          <action type="Rewrite" url="default.asp?gpdh=26" />
        </rule>
        <rule name="Admin Slider" stopProcessing="true">
          <match url="^slider-anh/?$" />
          <action type="Rewrite" url="default.asp?gpdh=8" />
        </rule>

        <!-- 4. Hệ thống -->
        <rule name="Admin Cau Hinh Website" stopProcessing="true">
          <match url="^cau-hinh/?$" />
          <action type="Rewrite" url="default.asp?gpdh=4" />
        </rule>
        <rule name="Admin Cau Hinh Text" stopProcessing="true">
          <match url="^cau-hinh-text/?$" />
          <action type="Rewrite" url="default.asp?gpdh=10" />
        </rule>
        <rule name="Admin Nguoi Dung" stopProcessing="true">
          <match url="^nguoi-dung/?$" />
          <action type="Rewrite" url="default.asp?gpdh=30" />
        </rule>
      <rule name="Admin Thoat he thong" stopProcessing="true">
          <match url="^logout/?$" />
          <action type="Rewrite" url="default.asp?gpdh=32" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>